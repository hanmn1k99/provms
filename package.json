{
  "name": "provms-enterprise",
  "version": "3.2.1",
  "description": "ProVMS Enterprise Edition",
  "author": "minhhan.net",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:frontend && electron-builder -w"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "better-sqlite3": "^11.2.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "fluent-ffmpeg": "^2.1.3",
    "node-media-server": "^2.7.0"
  },
  "devDependencies": {
    "electron": "^32.1.0",
    "electron-builder": "^25.0.5"
  },
  "build": {
    "appId": "com.meyschool.provms",
    "productName": "ProVMS Enterprise",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "main.js",
      "preload.js",
      "backend/**/*",
      "!backend/provms.db",
      "frontend/dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": ["nsis", "portable", "zip"],
      "icon": "frontend/public/favicon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": false
  }
}
